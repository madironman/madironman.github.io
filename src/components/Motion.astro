---
// Site-wide behaviour: scroll reveal, card tilt, active nav link, scroll
// progress, mobile menu, expandable lists. No dependencies.
---
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Scroll reveal, with a safety net so content can never stay hidden.
  const revealables = document.querySelectorAll<HTMLElement>('.reveal');
  if (reduce) revealables.forEach((el) => el.classList.add('in'));
  else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
    revealables.forEach((el) => io.observe(el));
    setTimeout(() => revealables.forEach((el) => el.classList.add('in')), 2000);
  }

  // HUD tilt on cards (pointer devices only)
  if (!reduce && window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      card.addEventListener('mousemove', (ev) => {
        const r = card.getBoundingClientRect();
        const px = (ev.clientX - r.left) / r.width, py = (ev.clientY - r.top) / r.height;
        card.style.setProperty('--rx', `${(0.5 - py) * 8}deg`);
        card.style.setProperty('--ry', `${(px - 0.5) * 10}deg`);
        card.style.setProperty('--mx', `${px * 100}%`);
        card.style.setProperty('--my', `${py * 100}%`);
      });
      card.addEventListener('mouseleave', () => { card.style.setProperty('--rx', '0deg'); card.style.setProperty('--ry', '0deg'); });
    });
  }

  // Active nav link
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav ul a[href^="/#"]')];
  const sections = links.map((a) => document.getElementById(a.getAttribute('href')!.slice(2))).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    const nav = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `/#${e.target.id}`));
      });
    }, { rootMargin: '-40% 0px -55% 0px' });
    sections.forEach((s) => nav.observe(s));
  }

  // Scroll progress
  const bar = document.getElementById('progress');
  if (bar) {
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  }

  // Mobile menu
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('nav-menu');
  if (menuBtn && menu) {
    const set = (open: boolean) => { menu.classList.toggle('open', open); menuBtn.setAttribute('aria-expanded', String(open)); menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); };
    menuBtn.addEventListener('click', () => set(!menu.classList.contains('open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }

  // Expandable lists: [data-expand] buttons reveal siblings marked .more-item
  document.querySelectorAll<HTMLButtonElement>('[data-expand]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const list = document.getElementById(btn.dataset.expand!);
      if (!list) return;
      const open = list.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show fewer' : btn.dataset.label || 'Show more';
    });
  });
</script>
