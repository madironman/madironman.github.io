---
// Arc-reactor HUD rings plus a live oscilloscope trace. Pure canvas, no deps.
// Respects prefers-reduced-motion (draws one static frame) and pauses off-screen.
---
<canvas class="hud" id="hud" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('hud') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CYAN = (a: number) => `rgba(87, 212, 255, ${a})`;
    const GOLD = (a: number) => `rgba(224, 176, 74, ${a})`;

    let w = 0, h = 0, raf = 0, visible = true;
    const t0 = performance.now();

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas!.clientWidth; h = canvas!.clientHeight;
      canvas!.width = w * dpr; canvas!.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function ring(cx: number, cy: number, r: number, rot: number, ticks: number, len: number, alpha: number, color: (a: number) => string) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(rot);
      ctx.strokeStyle = color(alpha);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(0, 0, r, 0, Math.PI * 2);
      ctx.stroke();
      ctx.lineWidth = 1.2;
      for (let i = 0; i < ticks; i++) {
        const a = (i / ticks) * Math.PI * 2;
        const l = i % 5 === 0 ? len * 1.8 : len;
        ctx.beginPath();
        ctx.moveTo(Math.cos(a) * r, Math.sin(a) * r);
        ctx.lineTo(Math.cos(a) * (r - l), Math.sin(a) * (r - l));
        ctx.stroke();
      }
      ctx.restore();
    }

    function arcs(cx: number, cy: number, r: number, rot: number, segs: number, gap: number, width: number, alpha: number, color: (a: number) => string) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(rot);
      ctx.strokeStyle = color(alpha);
      ctx.lineWidth = width;
      const span = (Math.PI * 2) / segs;
      for (let i = 0; i < segs; i++) {
        ctx.beginPath();
        ctx.arc(0, 0, r, i * span + gap, (i + 1) * span - gap);
        ctx.stroke();
      }
      ctx.restore();
    }

    function draw(now: number) {
      const t = (now - t0) / 1000;
      ctx.clearRect(0, 0, w, h);

      // --- arc reactor, right side ---
      const wide = w > 760;
      const cx = wide ? w * 0.76 : w * 0.5;
      const cy = wide ? h * 0.46 : h * 0.42;
      const R = Math.min(w, h) * (wide ? 0.34 : 0.42);

      const core = ctx.createRadialGradient(cx, cy, 0, cx, cy, R * 0.55);
      core.addColorStop(0, CYAN(0.22));
      core.addColorStop(0.45, CYAN(0.07));
      core.addColorStop(1, CYAN(0));
      ctx.fillStyle = core;
      ctx.beginPath(); ctx.arc(cx, cy, R * 0.55, 0, Math.PI * 2); ctx.fill();

      const pulse = 0.5 + 0.5 * Math.sin(t * 1.6);
      ctx.fillStyle = CYAN(0.35 + 0.25 * pulse);
      ctx.beginPath(); ctx.arc(cx, cy, R * 0.06, 0, Math.PI * 2); ctx.fill();

      ring(cx, cy, R, t * 0.08, 90, 6, 0.35, CYAN);
      arcs(cx, cy, R * 0.86, -t * 0.14, 8, 0.06, 2.5, 0.3, CYAN);
      ring(cx, cy, R * 0.72, -t * 0.05, 60, 4, 0.22, GOLD);
      arcs(cx, cy, R * 0.6, t * 0.22, 3, 0.35, 1.5, 0.45, GOLD);
      arcs(cx, cy, R * 0.42, -t * 0.3, 12, 0.12, 3, 0.35, CYAN);

      // --- oscilloscope traces along the bottom ---
      const baseY = h * 0.84;
      const amp = Math.min(40, h * 0.06);
      const trace = (fn: (x: number) => number, width: number, alpha: number, color: (a: number) => string) => {
        ctx.strokeStyle = color(alpha);
        ctx.lineWidth = width;
        ctx.beginPath();
        for (let x = 0; x <= w; x += 2) {
          const y = baseY + fn(x);
          if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
      };
      // analogue channel: two sinusoids plus a slow beat
      const analogue = (x: number) => {
        const p = x / w;
        return amp * (0.6 * Math.sin(p * 18 - t * 2.2) + 0.3 * Math.sin(p * 41 + t * 3.1)) * (0.7 + 0.3 * Math.sin(p * 3 - t * 0.4));
      };
      // digital channel: a clock, offset below
      const digital = (x: number) => {
        const p = x / w;
        const bit = Math.floor(p * 24 - t * 3) % 2 === 0 ? -1 : 1;
        return amp * 1.6 + bit * amp * 0.35;
      };
      trace(analogue, 4, 0.08, CYAN);
      trace(analogue, 1.2, 0.55, CYAN);
      trace(digital, 1, 0.35, GOLD);

      // faint grid for the scope
      ctx.strokeStyle = CYAN(0.05);
      ctx.lineWidth = 1;
      for (let x = 0; x <= w; x += 80) { ctx.beginPath(); ctx.moveTo(x, baseY - amp * 1.5); ctx.lineTo(x, baseY + amp * 2.2); ctx.stroke(); }
    }

    function loop(now: number) {
      draw(now);
      if (!reduce && visible && !document.hidden) raf = requestAnimationFrame(loop);
    }
    function start() { cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); }

    resize();
    window.addEventListener('resize', () => { resize(); if (reduce) draw(performance.now()); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }).observe(canvas);
    start();
  }
</script>
