---
// Full-page background: a lattice of dots lit by the interference of wave
// sources. Two sources orbit slowly; the cursor is a third that ripples while
// it moves and fades when it stops. Scroll speed accelerates the whole field.
// Fixed behind all content, ~30 fps, theme-aware. Skipped on phones, under
// reduced motion, and when the user prefers reduced data.
---
<canvas class="field" id="field" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('field') as HTMLCanvasElement | null;
  const small = window.matchMedia('(max-width: 760px)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lowData = window.matchMedia('(prefers-reduced-data: reduce)').matches;
  if (canvas && !small && !lowData) {
    const ctx = canvas.getContext('2d')!;
    const STEP = 26;
    let w = 0, h = 0, cols = 0, rows = 0, raf = 0, last = 0, lastDt = 0;
    const t0 = performance.now();

    let ACC = '255, 74, 74', GOLD = '242, 182, 50', light = false;
    const readTheme = () => {
      const s = getComputedStyle(document.documentElement);
      ACC = s.getPropertyValue('--accent-rgb').trim() || ACC;
      GOLD = s.getPropertyValue('--gold-rgb').trim() || GOLD;
      light = s.getPropertyValue('color-scheme').trim() === 'light';
    };

    // cursor source
    let px = -1e4, py = -1e4, strength = 0, lastMove = 0;
    window.addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; strength = Math.min(1, strength + 0.25); lastMove = performance.now(); }, { passive: true });
    // scroll accelerates the field
    let scrollVel = 0, lastY = window.scrollY, lastT = performance.now(), phase = 0;
    window.addEventListener('scroll', () => { const now = performance.now(); const dt = Math.max(8, now - lastT); scrollVel = scrollVel * 0.5 + Math.abs(window.scrollY - lastY) / dt * 1000 * 0.5; lastY = window.scrollY; lastT = now; }, { passive: true });

    function resize() {
      w = window.innerWidth; h = window.innerHeight;
      canvas!.width = w; canvas!.height = h;
      cols = Math.ceil(w / STEP) + 1; rows = Math.ceil(h / STEP) + 1;
    }

    function draw(now: number) {
      const t = (now - t0) / 1000;
      const dt = Math.min(0.1, lastDt);
      // decay inputs
      if (now - lastMove > 120) strength = Math.max(0, strength - dt * 0.9);
      scrollVel *= Math.pow(0.08, dt);
      const speed = 1.1 * (1 + Math.min(2.5, scrollVel / 900));
      phase += speed * dt;

      ctx.clearRect(0, 0, w, h);
      const s1x = w * (0.5 + 0.35 * Math.cos(t * 0.11)), s1y = h * (0.5 + 0.35 * Math.sin(t * 0.09));
      const s2x = w * (0.5 + 0.35 * Math.cos(t * 0.07 + 2)), s2y = h * (0.5 + 0.35 * Math.sin(t * 0.13 + 1));
      const k = 0.045;
      const base = light ? 0.02 : 0.03, range = light ? 0.06 : 0.12;
      const cursorOn = strength > 0.01;
      for (let j = 0; j < rows; j++) {
        const y = j * STEP;
        for (let i = 0; i < cols; i++) {
          const x = i * STEP;
          const d1 = Math.hypot(x - s1x, y - s1y), d2 = Math.hypot(x - s2x, y - s2y);
          let v = (Math.sin(d1 * k - phase) + Math.sin(d2 * k - phase)) * 0.5;
          if (cursorOn) {
            const d3 = Math.hypot(x - px, y - py);
            // tight ripple, strongest near the cursor, fading with distance
            v += strength * Math.sin(d3 * 0.09 - phase * 2.2) * Math.max(0, 1 - d3 / 420);
          }
          v = Math.max(-1, Math.min(1.4, v));
          const a = base + range * (v + 1) * 0.5;
          if (v > 0.82) { ctx.fillStyle = `rgba(${GOLD}, ${a + (light ? 0.05 : 0.1)})`; ctx.fillRect(x - 1, y - 1, 2, 2); }
          else { ctx.fillStyle = `rgba(${ACC}, ${a})`; ctx.fillRect(x, y, 1.4, 1.4); }
        }
      }
    }

    function loop(now: number) {
      if (now - last > 33) { lastDt = (now - last) / 1000; last = now; draw(now); }
      if (!reduce && !document.hidden) raf = requestAnimationFrame(loop);
    }
    function start() { cancelAnimationFrame(raf); last = performance.now(); raf = requestAnimationFrame(loop); }

    readTheme();
    resize();
    window.addEventListener('resize', () => { resize(); if (reduce) draw(performance.now()); });
    window.addEventListener('themechange', () => { readTheme(); if (reduce) draw(performance.now()); });
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => { readTheme(); if (reduce) draw(performance.now()); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    start();
  }
</script>
