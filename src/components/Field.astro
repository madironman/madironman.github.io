---
// Full-page background: a lattice of dots lit by the interference of two
// slowly orbiting wave sources. Fixed behind all content, ~30 fps, theme-aware.
---
<canvas class="field" id="field" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('field') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const STEP = 26;
    let w = 0, h = 0, cols = 0, rows = 0, raf = 0, last = 0;
    const t0 = performance.now();

    let ACC = '255, 74, 74', GOLD = '242, 182, 50', light = false;
    const readTheme = () => {
      const s = getComputedStyle(document.documentElement);
      ACC = s.getPropertyValue('--accent-rgb').trim() || ACC;
      GOLD = s.getPropertyValue('--gold-rgb').trim() || GOLD;
      light = s.getPropertyValue('color-scheme').trim() === 'light';
    };

    function resize() {
      w = window.innerWidth; h = window.innerHeight;
      canvas!.width = w; canvas!.height = h;
      cols = Math.ceil(w / STEP) + 1; rows = Math.ceil(h / STEP) + 1;
    }

    function draw(now: number) {
      const t = (now - t0) / 1000;
      ctx.clearRect(0, 0, w, h);
      const s1x = w * (0.5 + 0.35 * Math.cos(t * 0.11)), s1y = h * (0.5 + 0.35 * Math.sin(t * 0.09));
      const s2x = w * (0.5 + 0.35 * Math.cos(t * 0.07 + 2)), s2y = h * (0.5 + 0.35 * Math.sin(t * 0.13 + 1));
      const k = 0.045, wv = 1.1;
      const base = light ? 0.05 : 0.03, range = light ? 0.16 : 0.12;
      for (let j = 0; j < rows; j++) {
        const y = j * STEP;
        for (let i = 0; i < cols; i++) {
          const x = i * STEP;
          const d1 = Math.hypot(x - s1x, y - s1y), d2 = Math.hypot(x - s2x, y - s2y);
          const v = (Math.sin(d1 * k - t * wv) + Math.sin(d2 * k - t * wv)) * 0.5;
          const a = base + range * (v + 1) * 0.5;
          if (v > 0.82) { ctx.fillStyle = `rgba(${GOLD}, ${a + 0.1})`; ctx.fillRect(x - 1, y - 1, 2, 2); }
          else { ctx.fillStyle = `rgba(${ACC}, ${a})`; ctx.fillRect(x, y, 1.4, 1.4); }
        }
      }
    }

    function loop(now: number) {
      if (now - last > 33) { last = now; draw(now); }
      if (!reduce && !document.hidden) raf = requestAnimationFrame(loop);
    }
    function start() { cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); }

    readTheme();
    resize();
    window.addEventListener('resize', () => { resize(); if (reduce) draw(performance.now()); });
    window.addEventListener('themechange', () => { readTheme(); if (reduce) draw(performance.now()); });
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => { readTheme(); if (reduce) draw(performance.now()); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    start();
  }
</script>
