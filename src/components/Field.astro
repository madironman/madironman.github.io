---
// Full-page background: an electromagnetic field that stays quiet until touched.
//  E: a lattice of faint needles aligned to the field of a +/− pair. The pair
//     drifts on a very slow orbit; scroll spins it.
//  The cursor is a charge (double-click flips its sign). Needles only brighten
//     near the cursor, so the field reads as a probe, not a screensaver.
//  The two charges are free bodies: Coulomb force from the cursor (like signs
//     repel, unlike attract), a spring back to their orbit, and damping.
//  B: a moving charge is a current; faint circular field lines wrap the cursor
//     while it moves. Fast motion radiates a wavefront across the lattice.
// ~30 fps, theme-aware. Off on phones, under reduced motion (one static
// frame), and when the user prefers reduced data.
---
<canvas class="field" id="field" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('field') as HTMLCanvasElement | null;
  const small = window.matchMedia('(max-width: 760px)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lowData = window.matchMedia('(prefers-reduced-data: reduce)').matches;
  if (canvas && !small && !lowData) {
    const ctx = canvas.getContext('2d')!;
    const STEP = 26;
    let w = 0, h = 0, cols = 0, rows = 0, raf = 0, last = 0, lastDt = 0;

    let ACC = '255, 74, 74', GOLD = '242, 182, 50', CORE = '160, 228, 255', light = false;
    const readTheme = () => {
      const s = getComputedStyle(document.documentElement);
      ACC = s.getPropertyValue('--accent-rgb').trim() || ACC;
      GOLD = s.getPropertyValue('--gold-rgb').trim() || GOLD;
      CORE = s.getPropertyValue('--reactor-rgb').trim() || CORE;
      light = s.getPropertyValue('color-scheme').trim() === 'light';
    };
    const lift = (a: number) => Math.min(1, light ? a * 1.9 : a);

    // ---- cursor: charge with sign, velocity (for B), radiation ----
    let px = -1e4, py = -1e4, charge = 0, sign = 1, lastMove = 0;
    let vx = 0, vy = 0, lastPx = 0, lastPy = 0, lastPt = 0, lastRingT = 0;
    type Ring = { x: number; y: number; r: number; a: number };
    const rings: Ring[] = [];
    const qLabel = document.getElementById('t-q');
    const showSign = () => { if (qLabel) { qLabel.textContent = sign > 0 ? '+q' : '−q'; qLabel.className = sign > 0 ? 'plus' : 'minus'; } };
    window.addEventListener('pointermove', (e) => {
      const now = performance.now();
      if (lastPt) { const dt = Math.max(8, now - lastPt) / 1000; vx = vx * 0.6 + ((e.clientX - lastPx) / dt) * 0.4; vy = vy * 0.6 + ((e.clientY - lastPy) / dt) * 0.4; }
      lastPx = e.clientX; lastPy = e.clientY; lastPt = now;
      px = e.clientX; py = e.clientY; lastMove = now;
      charge = Math.min(1, charge + 0.25);
      // radiate only on genuinely fast motion, and rarely
      if (Math.hypot(vx, vy) > 900 && now - lastRingT > 320) { rings.push({ x: px, y: py, r: 0, a: 1 }); if (rings.length > 4) rings.shift(); lastRingT = now; }
    }, { passive: true });
    window.addEventListener('pointerleave', () => { px = -1e4; py = -1e4; });
    window.addEventListener('dblclick', () => { sign = -sign; showSign(); rings.push({ x: px, y: py, r: 0, a: 1 }); });
    showSign();

    // ---- scroll spins the dipole's orbit ----
    let scrollVel = 0, lastY = window.scrollY, lastT = performance.now(), spin = 0;
    window.addEventListener('scroll', () => { const now = performance.now(); const dt = Math.max(8, now - lastT); scrollVel = scrollVel * 0.5 + Math.abs(window.scrollY - lastY) / dt * 1000 * 0.5; lastY = window.scrollY; lastT = now; }, { passive: true });

    // ---- the two charges as free bodies ----
    type Body = { x: number; y: number; vx: number; vy: number; q: number };
    const bodies: Body[] = [{ x: 0, y: 0, vx: 0, vy: 0, q: 1 }, { x: 0, y: 0, vx: 0, vy: 0, q: -1 }];
    let seeded = false;

    function resize() {
      w = window.innerWidth; h = window.innerHeight;
      canvas!.width = w; canvas!.height = h;
      cols = Math.ceil(w / STEP) + 1; rows = Math.ceil(h / STEP) + 1;
    }

    const BUCKETS = 8;
    const paths: Path2D[] = [];

    function draw(now: number) {
      const dt = Math.min(0.1, lastDt);

      // inputs decay
      if (now - lastMove > 150) { charge = Math.max(0, charge - dt * 0.8); vx *= Math.pow(0.02, dt); vy *= Math.pow(0.02, dt); }
      scrollVel *= Math.pow(0.08, dt);
      spin += (0.02 + Math.min(0.8, scrollVel / 1100)) * dt;
      for (let i = rings.length - 1; i >= 0; i--) { const g = rings[i]; g.r += 340 * dt; g.a -= dt * 0.8; if (g.a <= 0) rings.splice(i, 1); }

      // orbit anchors, then Coulomb force from the cursor, spring, damping
      const ox = w * 0.5, oy = h * 0.5, ax = w * 0.32, ay = h * 0.30;
      const anchors = [
        { x: ox + ax * Math.cos(spin), y: oy + ay * Math.sin(spin) },
        { x: ox - ax * Math.cos(spin * 0.9 + 0.6), y: oy - ay * Math.sin(spin * 0.9 + 0.6) },
      ];
      if (!seeded) { bodies.forEach((b, i) => { b.x = anchors[i].x; b.y = anchors[i].y; }); seeded = true; }
      for (let i = 0; i < 2; i++) {
        const b = bodies[i], a = anchors[i];
        let fx = (a.x - b.x) * 2.2, fy = (a.y - b.y) * 2.2;            // spring to orbit
        if (charge > 0.02) {
          const dx = b.x - px, dy = b.y - py, d = Math.hypot(dx, dy) + 40;
          const f = (b.q * sign * charge * 2.6e6) / (d * d);           // like signs push apart, unlike pull together
          fx += (dx / d) * f; fy += (dy / d) * f;
        }
        b.vx = (b.vx + fx * dt) * Math.pow(0.15, dt); b.vy = (b.vy + fy * dt) * Math.pow(0.15, dt);
        b.x += b.vx * dt; b.y += b.vy * dt;
        const lim = 320; const ddx = b.x - a.x, ddy = b.y - a.y, dd = Math.hypot(ddx, ddy);
        if (dd > lim) { b.x = a.x + (ddx / dd) * lim; b.y = a.y + (ddy / dd) * lim; }
      }
      const [q1, q2] = bodies;
      const soft = 60 * 60;
      const cursorOn = charge > 0.02;

      ctx.clearRect(0, 0, w, h);
      for (let b = 0; b < BUCKETS; b++) paths[b] = new Path2D();
      const hot = new Path2D();

      for (let j = 0; j < rows; j++) {
        const y = j * STEP;
        for (let i = 0; i < cols; i++) {
          const x = i * STEP;
          let ex = 0, ey = 0;
          let dx = x - q1.x, dy = y - q1.y, d2 = dx * dx + dy * dy + soft, inv = 1 / (d2 * Math.sqrt(d2));
          ex += dx * inv; ey += dy * inv;
          dx = x - q2.x; dy = y - q2.y; d2 = dx * dx + dy * dy + soft; inv = 1 / (d2 * Math.sqrt(d2));
          ex -= dx * inv; ey -= dy * inv;
          let near = 0;
          if (cursorOn) {
            dx = x - px; dy = y - py; d2 = dx * dx + dy * dy + soft * 0.5; inv = sign * charge * 2.2 / (d2 * Math.sqrt(d2));
            ex += dx * inv; ey += dy * inv;
            near = Math.max(0, 1 - Math.sqrt(d2) / 340) * charge;      // the probe: brighten only near the cursor
          }
          const mag = Math.hypot(ex, ey);
          if (mag < 1e-9) continue;
          let ux = ex / mag, uy = ey / mag;

          let glow = 0;
          for (const g of rings) {
            const dr = Math.hypot(x - g.x, y - g.y) - g.r;
            if (dr > -20 && dr < 20) {
              const k = (1 - Math.abs(dr) / 20) * g.a;
              glow = Math.max(glow, k);
              const rx = (x - g.x) / (g.r + 1e-3), ry = (y - g.y) / (g.r + 1e-3);
              ux = ux * (1 - k) + rx * k; uy = uy * (1 - k) + ry * k;
              const n = Math.hypot(ux, uy) || 1; ux /= n; uy /= n;
            }
          }

          const s = Math.min(1, Math.max(0, (Math.log10(mag * 1e6) + 1.2) / 3.2));
          const len = 4 + 6 * s + 5 * near + 4 * glow;
          const alpha = 0.02 + 0.05 * s + 0.16 * near;
          const b = Math.min(BUCKETS - 1, Math.floor(alpha / 0.23 * BUCKETS));
          const path = glow > 0.3 ? hot : paths[b];
          path.moveTo(x - ux * len * 0.5, y - uy * len * 0.5);
          path.lineTo(x + ux * len * 0.5, y + uy * len * 0.5);
        }
      }
      ctx.lineWidth = 1; ctx.lineCap = 'round';
      for (let b = 0; b < BUCKETS; b++) { ctx.strokeStyle = `rgba(${ACC}, ${lift(0.02 + (b + 0.5) * 0.026)})`; ctx.stroke(paths[b]); }
      ctx.strokeStyle = `rgba(${GOLD}, ${lift(0.22)})`; ctx.lineWidth = 1.2; ctx.stroke(hot);

      ctx.lineWidth = 1;
      for (const g of rings) { ctx.strokeStyle = `rgba(${GOLD}, ${lift(0.05 * g.a)})`; ctx.beginPath(); ctx.arc(g.x, g.y, g.r, 0, Math.PI * 2); ctx.stroke(); }

      // B around the moving cursor
      const speed = Math.hypot(vx, vy);
      if (charge > 0.05 && speed > 60) {
        const k = Math.min(1, speed / 1200);
        ctx.save(); ctx.translate(px, py); ctx.rotate(Math.atan2(vy, vx));
        ctx.strokeStyle = `rgba(${CORE}, ${lift(0.14 * k * charge)})`; ctx.lineWidth = 1;
        for (let r = 14; r <= 62; r += 16) { ctx.beginPath(); ctx.ellipse(0, 0, r * 0.35, r, 0, 0, Math.PI * 2); ctx.stroke(); }
        ctx.restore();
      }

      // charge markers: + red, − blue; the cursor's marker follows its sign
      const mark = (x: number, y: number, sgn: number, a: number, col: string) => {
        ctx.strokeStyle = `rgba(${col}, ${lift(a)})`; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(x, y, 7, 0, Math.PI * 2); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(x - 3.5, y); ctx.lineTo(x + 3.5, y); if (sgn > 0) { ctx.moveTo(x, y - 3.5); ctx.lineTo(x, y + 3.5); } ctx.stroke();
      };
      mark(q1.x, q1.y, 1, 0.22, ACC);
      mark(q2.x, q2.y, -1, 0.22, CORE);
      if (charge > 0.05) mark(px, py, sign, 0.28 * charge, sign > 0 ? GOLD : CORE);
    }

    function loop(now: number) {
      if (now - last > 33) { lastDt = (now - last) / 1000; last = now; draw(now); }
      if (!reduce && !document.hidden) raf = requestAnimationFrame(loop);
    }
    function start() { cancelAnimationFrame(raf); last = performance.now(); raf = requestAnimationFrame(loop); }

    readTheme();
    resize();
    window.addEventListener('resize', () => { resize(); seeded = false; if (reduce) draw(performance.now()); });
    window.addEventListener('themechange', () => { readTheme(); if (reduce) draw(performance.now()); });
    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => { readTheme(); if (reduce) draw(performance.now()); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    start();
  }
</script>
