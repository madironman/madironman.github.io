---
import '../styles/global.css';
import Field from '../components/Field.astro';
import Motion from '../components/Motion.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  type = 'website',
  image = site.ogImage,
  imageAlt = `${site.fullName}, ${site.title}`,
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.url).href.replace(/\/$/, '') || site.url;
const imageUrl = new URL(image, site.url).href;

const person = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.fullName,
  alternateName: [site.legalName, site.handle],
  givenName: 'Madhevan',
  jobTitle: site.title,
  description: site.description,
  url: site.url,
  email: `mailto:${site.email}`,
  image: imageUrl,
  sameAs: [site.github, site.linkedin],
  worksFor: { '@type': 'Organization', name: site.employer },
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.alumniOf },
  address: { '@type': 'PostalAddress', addressLocality: site.location.city, addressRegion: site.location.region, addressCountry: site.location.country },
  knowsAbout: site.knowsAbout,
  knowsLanguage: ['en', 'ta'],
};
const website = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: `${site.fullName} · ${site.title}`,
  description: site.description,
  inLanguage: 'en',
  author: { '@id': `${site.url}/#person` },
  publisher: { '@id': `${site.url}/#person` },
};
const graph: any[] = [person, website];
if (type === 'article') {
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${canonical}#article`,
    headline: title,
    description,
    url: canonical,
    mainEntityOfPage: canonical,
    image: imageUrl,
    datePublished: publishedTime?.toISOString(),
    dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
    keywords: tags.join(', '),
    inLanguage: 'en',
    author: { '@id': `${site.url}/#person` },
    publisher: { '@id': `${site.url}/#person` },
    isPartOf: { '@id': `${site.url}/#website` },
  });
} else {
  graph.push({
    '@type': 'ProfilePage',
    '@id': `${site.url}/#profile`,
    url: site.url,
    mainEntity: { '@id': `${site.url}/#person` },
    isPartOf: { '@id': `${site.url}/#website` },
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>

    <!-- Identity -->
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="creator" content={site.fullName} />
    <meta name="publisher" content={site.fullName} />
    <meta name="keywords" content={[...site.keywords, ...tags].join(', ')} />
    <meta name="application-name" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="author" href={`${site.url}/humans.txt`} />
    <link rel="me" href={site.github} />
    <link rel="me" href={site.linkedin} />
    <link rel="me" href={`mailto:${site.email}`} />

    <!-- Robots -->
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="IN-TN" />
    <meta name="geo.placename" content={site.location.city} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.fullName} · ${site.title}`} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && <meta property="article:modified_time" content={(modifiedTime ?? publishedTime)?.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={site.url} />}
    {type === 'article' && <meta property="article:section" content="Engineering" />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    {type === 'website' && <meta property="profile:first_name" content="Madhevan" />}
    {type === 'website' && <meta property="profile:last_name" content="Ramalingam" />}
    {type === 'website' && <meta property="profile:username" content={site.handle} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:url" content={canonical} />

    <!-- Theme, icons, manifest -->
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#120e0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5efe7" media="(prefers-color-scheme: light)" />
    <meta name="msapplication-TileColor" content="#120e0e" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.fullName} · Writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Rajdhani:wght@500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      (function () { try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {} })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <Field />
    <nav class="nav" aria-label="Primary">
      <div class="wrap">
        <a class="brand" href="/"><span class="core"></span>madhevan</a>
        <ul id="nav-menu">
          <li><a href="/#about">About</a></li>
          <li><a href="/#experience">Experience</a></li>
          <li><a href="/#writing">Writing</a></li>
          <li><a href="/#tooling">Tooling</a></li>
          <li><a href="/#contact">Contact</a></li>
          <li class="social">
            <a href={site.github} aria-label="GitHub" target="_blank" rel="me noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg></a>
            <a href={site.linkedin} aria-label="LinkedIn" target="_blank" rel="me noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6c.5-.9 1.7-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.5V9h3.6v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg></a>
            <a href={`mailto:${site.email}`} aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
          </li>
        </ul>
        <div class="icons">
          <a href={site.github} aria-label="GitHub" target="_blank" rel="me noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>
          </a>
          <a href={site.linkedin} aria-label="LinkedIn" target="_blank" rel="me noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6c.5-.9 1.7-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.5V9h3.6v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>
          </a>
          <a href={`mailto:${site.email}`} aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
            <span>Theme</span>
          </button>
          <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path class="bars" d="M3 6h18M3 12h18M3 18h18"/><path class="x" d="M5 5l14 14M19 5 5 19"/></svg>
          </button>
        </div>
      </div>
    </nav>
    <main class="wrap" id="main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.fullName}</span> ·
        <a href="/rss.xml">RSS</a> ·
        <a href="https://github.com/madironman/madironman.github.io" target="_blank" rel="noopener">source</a> ·
        <a href="/humans.txt">humans.txt</a>
      </div>
    </footer>
    <Motion />
    <script>
      const btn = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const effective = () => root.getAttribute('data-theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      btn?.addEventListener('click', () => {
        const next = effective() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch {}
        window.dispatchEvent(new CustomEvent('themechange'));
      });
    </script>
  </body>
</html>
