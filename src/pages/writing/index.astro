---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Writing" description="Debug stories and notes from WLAN firmware and SoC bring-up.">
  <section class="block">
    <h2><span class="num">03</span>writing</h2>
    <p class="lede">
      Notes on mechanisms that firmware engineers keep meeting: how things work, why they fail,
      and what the fix pattern looks like. Everything here is public knowledge, written from the
      point of view of someone who has hit it.
    </p>
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <div>
            <h3><a href={`/writing/${p.id}`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
            <div class="tags">{p.data.tags.map((t) => <span>#{t}</span>)}</div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>
