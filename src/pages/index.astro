---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import { getCollection } from 'astro:content';
import { jobs, stats, recognition, principles, askMe } from '../data/experience';
import { tooling, projects } from '../data/projects';
import { site } from '../data/site';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const md = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const VISIBLE = 4;
---
<Base>
  <section class="hero">
    <HeroCanvas />
    <div class="inner">
      <p class="eyebrow">Firmware · SoC · 802.11</p>
      <h1 class="type" data-text="hi, madhevan here." data-name="madhevan">hi, <span class="name">madhevan</span> <span class="nw">here.<span class="cursor"></span></span></h1>
      <p class="tag">
        Firmware and SoC systems engineer in Chennai. I work where firmware meets silicon:
        <b>Wi-Fi chips</b>, <b>low-power architecture</b> and <b>pre-silicon bring-up</b>.
        Six years of tracing defects through RTL and waveforms, then writing the Cortex-R and Cortex-M code that works around them.
      </p>
      <p class="status-line"><span class="dot"></span>Chennai · IST · usually replies within two days</p>
      <a class="btn" href={`mailto:${site.email}`}>Email me</a>
      <a class="btn gold" href="/resume">Resume</a>
      <a class="textlink" href={site.linkedin} target="_blank" rel="noopener">or find me on LinkedIn →</a>
    </div>
    <a class="cue" href="#stats">↓ six years in four numbers</a>
  </section>

  <section id="stats" aria-label="At a glance">
    <dl class="stats reveal">
      {stats.map((s) => (
        <div class={`stat${s.highlight ? ' hi' : ''}`}>
          <dt class="label">{s.label}</dt>
          <dd class="value">{s.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="block reveal" id="experience">
    <h2>Experience</h2>
    <div class="xp">
      <div class="tabs" role="tablist" aria-label="Engagements">
        {jobs.map((j, i) => (
          <button role="tab" id={`tab-${j.id}`} aria-controls={`panel-${j.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{j.tab}</button>
        ))}
      </div>
      {jobs.map((j, i) => (
        <div class="panel" role="tabpanel" id={`panel-${j.id}`} aria-labelledby={`tab-${j.id}`} hidden={i !== 0}>
          <h3>{j.title}</h3>
          <p class="meta">{j.period} · {j.client}</p>
          <ul id={`list-${j.id}`}>
            {j.bullets.map((b, k) => <li class={k >= VISIBLE ? 'more-item' : ''} set:html={md(b)} />)}
          </ul>
          {j.bullets.length > VISIBLE && (
            <button class="expand" type="button" data-expand={`list-${j.id}`} data-label={`Show ${j.bullets.length - VISIBLE} more`} aria-expanded="false">Show {j.bullets.length - VISIBLE} more</button>
          )}
        </div>
      ))}
    </div>
  </section>

  <section aria-label="Recognition">
    <ul class="recognition reveal">
      {recognition.map((r) => <li class="item"><span class="star" aria-hidden="true">✦</span>{r}</li>)}
    </ul>
  </section>

  <section class="block reveal" id="writing">
    <h2>Writing</h2>
    <p class="lede">
      Notes on mechanisms that firmware engineers keep meeting: how things work, why they fail,
      and what the fix pattern looks like.
    </p>
    <ul class="posts">
      {posts.map((p, i) => (
        <li class="reveal" style={`--i: ${i}`}>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <div>
            <h3><a href={`/writing/${p.id}`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
            <div class="tags">{p.data.tags.map((t) => <span>#{t}</span>)}</div>
          </div>
        </li>
      ))}
    </ul>
    <a class="more" href="/writing">All writing →</a>
  </section>

  <section class="block reveal" id="projects">
    <h2>Projects</h2>
    <div class="grid">{projects.map((p, i) => <Card p={p} i={i} />)}</div>
  </section>

  <section class="block reveal" id="tooling">
    <h2>Tooling I built</h2>
    <p class="lede">
      For bring-up and debug work, described by the problem each one solved.
    </p>
    <div class="grid">{tooling.map((p, i) => <Card p={p} i={i} />)}</div>
  </section>

  <section class="block reveal" id="about">
    <h2>About</h2>
    <div class="about">
      <div>
        <p>
          I'm a Technical Lead at embedUR Systems. Most of the last four years went into Wi-Fi SoC
          firmware: designing how an application MCU and a WLAN core share sleep, bringing up a new
          chip on a hardware emulator before silicon existed, and writing the debug tooling the
          bring-up ran on. Before that I moved industrial switches from VxWorks to Linux and debugged
          DOCSIS gateways.
        </p>
        <p>
          The work I like most is the kind where the bug could be in the firmware, the RTL, or the clock
          tree, and the only way to find out is to read all three. I've filed an invention disclosure in
          802.11 power save and I mentor engineers through their first bring-up.
        </p>
        <p>
          Away from work I'm <b>madironman</b> in games, which tells you the film I'll defend at any
          party. The site's theme is not a coincidence.
        </p>
      </div>
      <div class="stack">
        <h3>Languages</h3>
        <ul><li>C</li><li>ARM assembly</li><li>Python</li><li>TCL / Bash</li></ul>
        <h3>Firmware</h3>
        <ul><li>FreeRTOS</li><li>Bare-metal bring-up</li><li>Linux kernel drivers</li><li>Secure boot</li></ul>
        <h3>Silicon</h3>
        <ul><li>AXI / AHB / APB</li><li>PCIe / SDIO</li><li>PMU &amp; clock domains</li><li>DMA engines</li></ul>
        <h3>Debug</h3>
        <ul><li>JTAG / ADIv5</li><li>OpenOCD / GDB</li><li>Lauterbach TRACE32</li><li>Emulation / FPGA</li></ul>
      </div>
    </div>
    <ul class="principles" aria-label="How I work">
      {principles.map((p) => <li><b>{p.title}</b><span>{p.body}</span></li>)}
    </ul>
  </section>

  <section class="block contact reveal" id="contact">
    <h2>Let's build something that boots</h2>
    <p>
      Working on a firmware, SoC or wireless problem? Email is fastest. I read everything and reply within two days.
    </p>
    <a class="btn" href={`mailto:${site.email}?subject=Hello%20from%20your%20site`}>Email {site.email}</a>
    <a class="btn gold" href="/resume">Resume</a>
    <address class="links">
      <a href={site.github} target="_blank" rel="me noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>GitHub</a>
      <a href={site.linkedin} target="_blank" rel="me noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6c.5-.9 1.7-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.5V9h3.6v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>LinkedIn</a>
    </address>
    <p class="askme"><span class="hud-label">Ask me about</span>{askMe.map((a) => <span class="chip">{a}</span>)}</p>
  </section>

<script>
  // Experience tabs
  const tabs = document.querySelectorAll<HTMLButtonElement>('.xp [role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('.xp [role="tabpanel"]');
  tabs.forEach((tab, i) => {
    const activate = () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => { p.hidden = p.id !== tab.getAttribute('aria-controls'); });
    };
    tab.addEventListener('click', activate);
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const next = tabs[(i + dir + tabs.length) % tabs.length];
      next.focus(); next.click();
    });
  });

  // Typewriter on the headline. The full text is laid out from the start and
  // characters are revealed by visibility, so nothing below the headline moves.
  const h1 = document.querySelector<HTMLElement>('h1.type');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (h1 && !reduce) {
    const wrap = (node: Node, out: HTMLElement[]) => {
      [...node.childNodes].forEach((n) => {
        if (n.nodeType === Node.TEXT_NODE) {
          const frag = document.createDocumentFragment();
          for (const ch of n.textContent || '') { const sp = document.createElement('span'); sp.textContent = ch; sp.className = 'ch'; sp.style.visibility = 'hidden'; frag.appendChild(sp); out.push(sp); }
          n.replaceWith(frag);
        } else if (n instanceof HTMLElement && !n.classList.contains('cursor')) wrap(n, out);
      });
    };
    const chars: HTMLElement[] = [];
    wrap(h1, chars);
    const cursor = h1.querySelector<HTMLElement>('.cursor');
    if (cursor && chars[0]) chars[0].insertAdjacentElement('beforebegin', cursor);
    const nameStart = chars.findIndex((c) => c.parentElement?.classList.contains('name'));
    let n = 0;
    const tick = () => {
      chars[n].style.visibility = 'visible';
      if (cursor) chars[n].insertAdjacentElement('afterend', cursor);
      n++;
      if (n < chars.length) setTimeout(tick, n === nameStart ? 220 : 55 + Math.random() * 40);
      else setTimeout(() => cursor?.classList.add('done'), 1800);
    };
    setTimeout(tick, 300);
  } else if (h1) {
    h1.querySelector('.cursor')?.classList.add('done');
  }
</script>
</Base>

