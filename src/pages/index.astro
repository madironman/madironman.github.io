---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import { jobs } from '../data/experience';
import { tools, hardware } from '../data/projects';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<Base>
  <section class="hero">
    <svg class="trace" viewBox="0 0 1000 400" preserveAspectRatio="none" aria-hidden="true">
      <g fill="none" stroke="#5eead4" stroke-width="1.2">
        <path d="M0 80h60v-30h50v30h90v-30h40v30h120v-30h30v30h200v-30h70v30h140v-30h50v30h150"/>
        <path d="M0 160h120v-30h30v30h60v-30h90v30h40v-30h110v30h160v-30h30v30h80v-30h120v30h160"/>
        <path d="M0 240h40v-30h70v30h150v-30h30v30h70v-30h120v30h40v-30h60v30h200v-30h50v30h170"/>
        <path d="M0 320h200v-30h30v30h30v-30h30v30h140v-30h90v30h60v-30h30v30h240v-30h60v30h90"/>
      </g>
    </svg>
    <div class="inner">
      <h1>hi, <span class="name">madhevan</span> here.<span class="cursor"></span></h1>
      <p class="tag">
        Firmware and SoC systems engineer in Chennai. I work where firmware meets silicon:
        <b>802.11 WLAN chips</b>, <b>low-power architecture</b> and <b>pre-silicon bring-up</b>.
        Six years of tracing defects through RTL and waveforms, then writing the Cortex-R4 / M4 / M52 code that works around them.
      </p>
      <a class="btn" href="mailto:madhevan1998@gmail.com">Say hi</a>
      <a class="btn" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
    </div>
  </section>

  <section class="block" id="about">
    <h2>about me</h2>
    <div class="about">
      <div>
        <p>
          I'm a Technical Lead at embedUR Systems, where I've spent most of the last four years inside
          Synaptics Wi-Fi SoCs: designing the sleep protocol between the MCU and WLAN cores, bringing up
          a new chip on a Veloce emulator before silicon existed, and writing the debug tooling the
          bring-up ran on. Before that I moved industrial switches from VxWorks to Linux for Hirschmann
          and debugged DOCSIS gateways for CommScope.
        </p>
        <p>
          The work I like most is the kind where the bug could be in the firmware, the RTL, or the clock
          tree, and the only way to find out is to read all three. I've filed an invention disclosure on
          adaptive power-save packet retrieval and I mentor engineers through their first bring-up.
        </p>
        <p>
          Away from work I'm <b>madironman</b> in games, and I build small hardware things that
          usually end up measuring Wi-Fi.
        </p>
      </div>
      <ul class="stack">
        <h3>Languages</h3>
        <li>C</li><li>ARM assembly</li><li>Python</li><li>TCL / Bash</li>
        <h3>Firmware</h3>
        <li>FreeRTOS</li><li>Bare-metal bring-up</li><li>Linux kernel drivers</li><li>Secure boot</li>
        <h3>Silicon</h3>
        <li>AXI / AHB / APB</li><li>PCIe / SDIO</li><li>PMU &amp; clock domains</li><li>M2M DMA</li>
        <h3>Debug</h3>
        <li>JTAG / ADIv5</li><li>OpenOCD / GDB</li><li>Lauterbach TRACE32</li><li>Veloce / FPGA</li>
      </ul>
    </div>
  </section>

  <section class="block" id="experience">
    <h2>experience</h2>
    <div class="xp">
      <div class="tabs" role="tablist" aria-label="Employers">
        {jobs.map((j, i) => (
          <button role="tab" id={`tab-${j.id}`} aria-controls={`panel-${j.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{j.tab}</button>
        ))}
      </div>
      {jobs.map((j, i) => (
        <div class="panel" role="tabpanel" id={`panel-${j.id}`} aria-labelledby={`tab-${j.id}`} hidden={i !== 0}>
          <h3>{j.title} <span>@ {j.tab}</span></h3>
          <p class="meta">{j.period} · {j.client}</p>
          <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="block" id="writing">
    <h2>writing</h2>
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <div>
            <h3><a href={`/writing/${p.id}`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
            <div class="tags">{p.data.tags.map((t) => <span>#{t}</span>)}</div>
          </div>
        </li>
      ))}
    </ul>
    <a class="more" href="/writing">All writing →</a>
  </section>

  <section class="block" id="tools">
    <h2>tools</h2>
    <div class="grid">{tools.map((p) => <Card p={p} />)}</div>
  </section>

  <section class="block" id="hardware">
    <h2>hardware</h2>
    <div class="grid">{hardware.map((p) => <Card p={p} />)}</div>
  </section>

  <section class="block contact" id="contact">
    <h2>get in touch</h2>
    <p>
      Whether it's a chip that won't boot, a power number that won't drop, or a role where firmware
      meets hardware, I'd like to hear about it.
    </p>
    <a class="btn" href="mailto:madhevan1998@gmail.com">Say hi</a>
  </section>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.xp [role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('.xp [role="tabpanel"]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => { p.hidden = p.id !== tab.getAttribute('aria-controls'); });
    });
  });
</script>
