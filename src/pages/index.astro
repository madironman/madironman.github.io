---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import { getCollection } from 'astro:content';
import { jobs } from '../data/experience';
import { tooling, projects } from '../data/projects';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<Base>
  <section class="hero">
    <HeroCanvas />
    <div class="inner">
      <p class="eyebrow">Firmware · SoC · 802.11</p>
      <h1 class="type" data-text="hi, madhevan here." data-name="madhevan">hi, <span class="name">madhevan</span> <span class="nw">here.<span class="cursor"></span></span></h1>
      <p class="tag">
        Firmware and SoC systems engineer in Chennai. I work where firmware meets silicon:
        <b>Wi-Fi chips</b>, <b>low-power architecture</b> and <b>pre-silicon bring-up</b>.
        Six years of tracing defects through RTL and waveforms, then writing the Cortex-R and Cortex-M code that works around them.
      </p>
      <a class="btn" href="mailto:madhevan1998@gmail.com">Say hi</a>
      <a class="btn gold" href="https://www.linkedin.com/in/madhevan-ramalingam-4934ab32a/" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </section>

  <section class="block reveal" id="about">
    <h2><span class="num">01</span>about me</h2>
    <div class="about">
      <div>
        <p>
          I'm a Technical Lead at embedUR Systems. Most of the last four years went into Wi-Fi SoC
          firmware: designing how an application MCU and a WLAN core share sleep, bringing up a new
          chip on a hardware emulator before silicon existed, and writing the debug tooling the
          bring-up ran on. Before that I moved industrial switches from VxWorks to Linux and debugged
          DOCSIS gateways.
        </p>
        <p>
          The work I like most is the kind where the bug could be in the firmware, the RTL, or the clock
          tree, and the only way to find out is to read all three. I've filed an invention disclosure in
          802.11 power save and I mentor engineers through their first bring-up.
        </p>
        <p>
          Away from work I'm <b>madironman</b> in games, which tells you the film I'll defend at any
          party. The site's theme is not a coincidence.
        </p>
      </div>
      <ul class="stack">
        <h3>Languages</h3>
        <li>C</li><li>ARM assembly</li><li>Python</li><li>TCL / Bash</li>
        <h3>Firmware</h3>
        <li>FreeRTOS</li><li>Bare-metal bring-up</li><li>Linux kernel drivers</li><li>Secure boot</li>
        <h3>Silicon</h3>
        <li>AXI / AHB / APB</li><li>PCIe / SDIO</li><li>PMU &amp; clock domains</li><li>DMA engines</li>
        <h3>Debug</h3>
        <li>JTAG / ADIv5</li><li>OpenOCD / GDB</li><li>Lauterbach TRACE32</li><li>Emulation / FPGA</li>
      </ul>
    </div>
  </section>

  <section class="block reveal" id="experience">
    <h2><span class="num">02</span>experience</h2>
    <div class="xp">
      <div class="tabs" role="tablist" aria-label="Engagements">
        {jobs.map((j, i) => (
          <button role="tab" id={`tab-${j.id}`} aria-controls={`panel-${j.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{j.tab}</button>
        ))}
      </div>
      {jobs.map((j, i) => (
        <div class="panel" role="tabpanel" id={`panel-${j.id}`} aria-labelledby={`tab-${j.id}`} hidden={i !== 0}>
          <h3>{j.title}</h3>
          <p class="meta">{j.period} · {j.client}</p>
          <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="block reveal" id="writing">
    <h2><span class="num">03</span>writing</h2>
    <p class="lede">
      Notes on mechanisms that firmware engineers keep meeting: how things work, why they fail,
      and what the fix pattern looks like.
    </p>
    <ul class="posts">
      {posts.map((p, i) => (
        <li class="reveal" style={`--i: ${i}`}>
          <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
          <div>
            <h3><a href={`/writing/${p.id}`}>{p.data.title}</a></h3>
            <p>{p.data.summary}</p>
            <div class="tags">{p.data.tags.map((t) => <span>#{t}</span>)}</div>
          </div>
        </li>
      ))}
    </ul>
    <a class="more" href="/writing">All writing →</a>
  </section>

  <section class="block reveal" id="tooling">
    <h2><span class="num">04</span>tooling</h2>
    <p class="lede">
      Tools I built for bring-up and debug work, described by the problem each one solved.
    </p>
    <div class="grid">{tooling.map((p, i) => <Card p={p} i={i} />)}</div>
  </section>

  <section class="block reveal" id="projects">
    <h2><span class="num">05</span>projects</h2>
    <div class="grid">{projects.map((p, i) => <Card p={p} i={i} />)}</div>
  </section>

  <section class="block contact reveal" id="contact">
    <h2><span class="num">06</span>get in touch</h2>
    <p>
      Whether it's a chip that won't boot, a power number that won't drop, or a role where firmware
      meets hardware, I'd like to hear about it.
    </p>
    <a class="btn" href="mailto:madhevan1998@gmail.com">Say hi</a>
  </section>
</Base>

<script>
  // Experience tabs
  const tabs = document.querySelectorAll<HTMLButtonElement>('.xp [role="tab"]');
  const panels = document.querySelectorAll<HTMLElement>('.xp [role="tabpanel"]');
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => { p.hidden = p.id !== tab.getAttribute('aria-controls'); });
    });
  });

  // Typewriter on the headline. Server-rendered text stays for no-JS and crawlers.
  const h1 = document.querySelector<HTMLElement>('h1.type');
  if (h1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const full = h1.dataset.text!;
    const name = h1.dataset.name!;
    const start = full.indexOf(name), end = start + name.length;
    const render = (n: number) => {
      const s = full.slice(0, n);
      const pre = s.slice(0, Math.min(n, start));
      const mid = s.slice(start, Math.min(n, end));
      const post = n > end ? s.slice(end) : '';
      h1.innerHTML = post ? `${pre}<span class="name">${mid}</span><span class="nw">${post}<span class="cursor"></span></span>` : `${pre}<span class="name nw">${mid}<span class="cursor"></span></span>`;
    };
    let n = 0;
    render(0);
    const tick = () => { n++; render(n); if (n < full.length) setTimeout(tick, n === start ? 220 : 55 + Math.random() * 40); };
    setTimeout(tick, 300);
  }
</script>
