---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getNotes, fmtDate, isoDate, smart } from '../data/writing';
import {
  summary,
  employer,
  engagements,
  skills,
  disclosure,
  publication,
  awards,
  education,
} from '../data/resume';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Bold markup, and keep "Wi-Fi" from breaking at its hyphen. Text is unchanged.
const md = (s: string) =>
  esc(s)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/Wi-Fi/g, '<span class="nw">Wi-Fi</span>');
const current = employer.titles[0];
const schoolShort = education.school.replace(/, Chennai$/, '');
const notes = await getNotes();
---
<Base>
  <section class="hero" aria-labelledby="name">
    <div class="hero-main">
      <h1 id="name">{site.name}</h1>
      <p class="role">{site.title}</p>
      <p class="focus">{site.focus.join(' · ')}</p>
      <p class="meta">{current.title}, {employer.name} · {site.location}</p>
      <p class="lede" set:html={md(summary.approach ? `${summary.lede} ${summary.approach}` : summary.lede)} />
      <ul class="actions" aria-label="Resume and profiles">
        <li><a class="btn primary" href={site.resume}>Resume <span class="btn-sub">PDF</span></a></li>
        <li><a class="btn" href={site.linkedin}>LinkedIn</a></li>
        <li><a class="btn" href={site.github}>GitHub</a></li>
        <li><a class="btn" href={`mailto:${site.email}`}>Email</a></li>
      </ul>
      <p class="print-only">{site.email} · {site.linkedinLabel} · madironman.github.io</p>
    </div>

    <aside class="glance" aria-labelledby="glance-title">
      <h2 id="glance-title" class="kicker">At a glance</h2>
      <p class="org"><strong>{employer.name}</strong> <span class="when">{employer.dates}</span></p>
      <p class="titles">
        {employer.titles.map((t, i) => (
          <Fragment>{i > 0 && ' · '}<span class="nw">{t.title} ({t.years})</span></Fragment>
        ))}
      </p>
      <ol class="timeline" aria-label="Client engagements, newest first">
        {engagements.map((e) => (
          <li>
            <a href={`#${e.id}`}><strong>{e.client}</strong><span class="vh">, </span><span class="what">{e.scope}</span></a>
            <span class="when">{e.dates}</span>
          </li>
        ))}
      </ol>
      <p class="edu"><strong>{education.degree}</strong>, {schoolShort}, {education.dates}. Department topper.</p>
    </aside>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Selected work</h2>
      <p class="section-note">Client engagements at {employer.name}, newest first. Each opens with a short case study: problem, approach, result.</p>
    </div>
    <div class="section-body">
      {engagements.map((e) => (
        <article class="eng" id={e.id} aria-labelledby={`${e.id}-title`}>
          <header class="eng-head">
            <h3 id={`${e.id}-title`}><span class="client">{e.client}</span><span class="vh">, </span><span class="scope">{e.scope}</span></h3>
            <p class="when">{e.dates}</p>
          </header>
          {e.intro && <p class="eng-intro" set:html={md(e.intro)} />}
          {e.cases.map((c) => (
            <section class="case" aria-labelledby={`${c.id}-title`}>
              <h4 id={`${c.id}-title`}>{c.title}</h4>
              <dl class="par">
                <div><dt>Problem</dt><dd>{c.problem}</dd></div>
                <div><dt>Approach</dt><dd>{c.approach}</dd></div>
                <div class="res"><dt>Result</dt><dd>{c.result}</dd></div>
              </dl>
              {c.note && <p class="award"><span class="k">Recognition</span> {c.note}</p>}
            </section>
          ))}
          {e.more.map((g) => (
            <div class="group">
              <h4 class="kicker">{g.label}</h4>
              <ul>{g.items.map((i) => <li set:html={md(i)} />)}</ul>
            </div>
          ))}
          {e.note && <p class="award"><span class="k">Recognition</span> {e.note}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="writing" aria-labelledby="writing-title">
    <div class="section-head">
      <h2 id="writing-title">Writing</h2>
      <p class="section-note">Notes on public mechanisms and debugging methods.</p>
    </div>
    <div class="section-body">
      <ul class="notes">
        {notes.map((n) => (
          <li>
            <h3><a href={`/writing/${n.id}`}>{smart(n.data.title)}</a></h3>
            <p>{smart(n.data.summary)}</p>
            <p class="when"><time datetime={isoDate(n.data.date)}>{fmtDate(n.data.date)}</time></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-title">
    <div class="section-head">
      <h2 id="skills-title">Skills</h2>
    </div>
    <div class="section-body">
      <dl class="skills">
        {skills.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.text}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" id="invention" aria-labelledby="invention-title">
    <div class="section-head">
      <h2 id="invention-title">Invention disclosure &amp; publication</h2>
    </div>
    <div class="section-body">
      <div class="entry">
        <h3>Invention disclosure <span class="muted">· 802.11 power save</span></h3>
        <p>{disclosure}</p>
      </div>
      <div class="entry">
        <h3>Publication</h3>
        <p>{publication.text}</p>
      </div>
      {awards.length > 0 && (
        <div class="entry">
          <h3>Awards</h3>
          <ul>{awards.map((a) => <li>{a}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="education" aria-labelledby="education-title">
    <div class="section-head">
      <h2 id="education-title">Education</h2>
    </div>
    <div class="section-body">
      <div class="entry">
        <h3>{education.degree}</h3>
        <p class="sub">{education.school} · {education.dates}</p>
        <ul>{education.points.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="section-head">
      <h2 id="contact-title">Contact</h2>
    </div>
    <div class="section-body">
      <address>
        <dl class="contact">
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href={site.linkedin}>{site.linkedinLabel}</a></dd></div>
          <div><dt>GitHub</dt><dd><a href={site.github}>{site.githubLabel}</a></dd></div>
          <div><dt>Resume</dt><dd><a href={site.resume}>Madhevan_Ramalingam_Resume.pdf</a> <span class="muted">(PDF, 2 pages)</span></dd></div>
          <div><dt>Location</dt><dd>{site.location}</dd></div>
        </dl>
      </address>
    </div>
  </section>
</Base>
